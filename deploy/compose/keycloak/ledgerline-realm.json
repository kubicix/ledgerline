{
  "realm": "ledgerline",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "customer" },
      { "name": "merchant" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "ledgerline-web",
      "name": "Ledgerline Blazor UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5100/*"],
      "webOrigins": ["http://localhost:5100"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ]
}
