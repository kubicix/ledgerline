{
  "realm": "ledgerline",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "customer"
      },
      {
        "name": "merchant"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ledgerline-web",
      "name": "Ledgerline Blazor UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5100/*"
      ],
      "webOrigins": [
        "http://localhost:5100"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "protocolMapper": "oidc-audience-mapper",
          "name": "ledgerline-api-audience",
          "config": {
            "id.token.claim": "false",
            "included.client.audience": "ledgerline-api",
            "access.token.claim": "true"
          },
          "consentRequired": false,
          "protocol": "openid-connect"
        },
        {
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "name": "realm-roles",
          "config": {
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "claim.name": "roles",
            "multivalued": "true"
          },
          "consentRequired": false,
          "protocol": "openid-connect"
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ]
    },
    {
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": false,
      "clientId": "ledgerline-api"
    },
    {
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "enabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "protocolMapper": "oidc-audience-mapper",
          "name": "ledgerline-api-audience",
          "config": {
            "id.token.claim": "false",
            "included.client.audience": "ledgerline-api",
            "access.token.claim": "true"
          },
          "consentRequired": false,
          "protocol": "openid-connect"
        },
        {
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "name": "realm-roles",
          "config": {
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "claim.name": "roles",
            "multivalued": "true"
          },
          "consentRequired": false,
          "protocol": "openid-connect"
        }
      ],
      "clientId": "ledgerline-k6",
      "publicClient": true,
      "protocol": "openid-connect"
    }
  ],
