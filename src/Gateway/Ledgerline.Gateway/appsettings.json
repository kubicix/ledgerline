{
  "ReverseProxy": {
    "Routes": {
      "accounts": { "ClusterId": "accounts", "AuthorizationPolicy": "default", "Timeout": "00:00:10", "Match": { "Path": "/api/accounts/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api" } ] },
      "ledger": { "ClusterId": "accounts", "AuthorizationPolicy": "Admin", "Timeout": "00:00:10", "Match": { "Path": "/api/ledger/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api" } ] },
      "topups": { "ClusterId": "payments", "AuthorizationPolicy": "Customer", "Timeout": "00:00:10", "Match": { "Path": "/api/topups/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api" } ] },
      "transfers": { "ClusterId": "payments", "AuthorizationPolicy": "Customer", "Timeout": "00:00:10", "Match": { "Path": "/api/transfers/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api" } ] },
      "payments": { "ClusterId": "payments", "AuthorizationPolicy": "default", "Timeout": "00:00:10", "Match": { "Path": "/api/payments/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api" } ] },
      "risk": { "ClusterId": "risk", "AuthorizationPolicy": "Admin", "Timeout": "00:00:10", "Match": { "Path": "/api/risk/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api" } ] },
      "notifications": { "ClusterId": "notifications", "AuthorizationPolicy": "default", "Timeout": "00:00:10", "Match": { "Path": "/api/notifications/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/api" } ] }
    },
    "Clusters": {
      "accounts": { "Destinations": { "primary": { "Address": "http://accounts:8080" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } }, "HttpRequest": { "ActivityTimeout": "00:00:10" } },
      "payments": { "Destinations": { "primary": { "Address": "http://payments:8080" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } }, "HttpRequest": { "ActivityTimeout": "00:00:10" } },
      "risk": { "Destinations": { "primary": { "Address": "http://risk:8080" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } }, "HttpRequest": { "ActivityTimeout": "00:00:10" } },
      "notifications": { "Destinations": { "primary": { "Address": "http://notifications:8080" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } }, "HttpRequest": { "ActivityTimeout": "00:00:10" } }
    }
  }
}
